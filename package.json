{
  "name": "sprout-hollow",
  "version": "1.0.0",
  "description": "A cozy pixel-art farming game for the desktop. Clear the valley, work the soil, survive four seasons.",
  "license": "MIT",
  "author": "DingDingChae",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run build:main && vite build && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win squirrel --publish never",
    "count": "node scripts/count-lines.mjs",
    "check:build": "node scripts/check-build-config.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "uk.dewhui.sprouthollow",
    "productName": "Sprout Hollow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "squirrel"
      ],
      "signAndEditExecutable": false,
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "squirrelWindows": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "msi": false
    },
    "forceCodeSigning": false
  }
}
